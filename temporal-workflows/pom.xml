<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.documenter</groupId>
        <artifactId>github-repo-documenter</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>temporal-workflows</artifactId>
    <name>temporal-workflows</name>
    <description>Temporal Workflows module — encapsulates all Temporal workflow and Activity definitions</description>

    <dependencies>
        <!-- Depends on vcs-gateway for VCSProvider interface -->
        <dependency>
            <groupId>com.example.documenter</groupId>
            <artifactId>vcs-gateway</artifactId>
        </dependency>

        <!-- Depends on ai-gateway for AIGateway interface -->
        <dependency>
            <groupId>com.example.documenter</groupId>
            <artifactId>ai-gateway</artifactId>
        </dependency>

        <!-- Temporal Java SDK -->
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-sdk</artifactId>
        </dependency>

        <!-- Spring Boot starter for config and component scanning -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
        </dependency>
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-testing</artifactId>
            <version>1.22.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Configuration processor — generates IDE auto-completion metadata -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Validation — required for @Validated on TemporalProperties -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

</project>
